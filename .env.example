PORT=3000
CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
ACCESS_TOKEN_SECRET=your_jwt_secret_key_here
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_key_here
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX=
STRICT_RATE_LIMIT_WINDOW_MS=
STRICT_RATE_LIMIT_MAX=